NODE_ENV=production
PRECOMMUNITY_NETWORK=base
NEXT_PUBLIC_PRECOMMUNITY_NETWORK=base
PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
PUBLIC_ESCROW_DEPLOYMENT_BLOCK=0
PUBLIC_PRE_ADDRESS=0x0000000000000000000000000000000000000000
PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
PUBLIC_INITIAL_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
PUBLIC_CHAIN_CONFIRMATIONS=12
# Base Sepolia deployment values. Replace zeros from base-sepolia.escrow.json during cutover.
ESCROW_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
ESCROW_DEPLOYMENT_BLOCK_TESTNET=0
PRE_ADDRESS_TESTNET=0x5471386EA2022e724A234A7690E338aA0A6689aD
USDC_ADDRESS_TESTNET=0xdeBe6c9F496Bb7cca66727E9B8CB5B49f631058D
INITIAL_OWNER_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
CHAIN_CONFIRMATIONS_TESTNET=6
SAFE_ADDRESS=0x0000000000000000000000000000000000000000
SAFE_ADDRESS_TESTNET=
# Required for Safe proposals. The deployment script transfers the key over SSH standard input.
SAFE_TRANSACTION_SERVICE_API_KEY=
# Optional only when using a custom Transaction Service deployment.
SAFE_TRANSACTION_SERVICE_URL=
SAFE_TRANSACTION_SERVICE_URL_TESTNET=
WEB_ORIGIN=https://precommunity.org
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://127.0.0.1:4000
# Required for RainbowKit mobile wallets and WalletConnect QR connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URL_TESTNET=https://sepolia.base.org
COMMUNITY_MIN_PRE=1
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_TIMEOUT_MS=5000
SIWE_DOMAIN=precommunity.org
SIWE_URI=https://precommunity.org
SESSION_SECRET=generated-on-the-server
ADS_REPORT_FINGERPRINT_SECRET=generated-independently-on-the-server
# Both values stay empty until the reviewed PRE Keyword Market ABI and deployment are delivered.
ADS_CONTRACT_ADDRESS=
ADS_CONTRACT_DEPLOYMENT_BLOCK=
ADS_CONTRACT_ADDRESS_TESTNET=
ADS_CONTRACT_DEPLOYMENT_BLOCK_TESTNET=
