[Unit]
Description=precommunity application logs to Axiom
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
User=precommunity-vector
Group=precommunity-vector
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/precommunity/axiom.env
ExecStart=/opt/precommunity-vector/0.56.0/bin/vector --config /etc/precommunity-vector/vector.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=precommunity-vector
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
