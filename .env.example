NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://precommunity:precommunity@127.0.0.1:5432/precommunity?schema=public
DATABASE_URL_TESTNET=postgresql://precommunity:precommunity@127.0.0.1:5432/precommunity?schema=testnet
REDIS_URL=redis://127.0.0.1:6379
REDIS_URL_TESTNET=redis://127.0.0.1:6379/1
WEB_ORIGIN=http://localhost:3011
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://127.0.0.1:4000
# Required for RainbowKit mobile wallets and WalletConnect QR connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
PRECOMMUNITY_NETWORK=base-sepolia
NEXT_PUBLIC_PRECOMMUNITY_NETWORK=base-sepolia
BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URL_TESTNET=https://sepolia.base.org
NEXT_PUBLIC_BASE_RPC_URL_TESTNET=https://sepolia.base.org
# Base mainnet deployment values.
PUBLIC_ESCROW_ADDRESS=
PUBLIC_ESCROW_DEPLOYMENT_BLOCK=
PUBLIC_PRE_ADDRESS=
PUBLIC_USDC_ADDRESS=
PUBLIC_INITIAL_OWNER_ADDRESS=
PUBLIC_TREASURY_ADDRESS=
PUBLIC_CHAIN_CONFIRMATIONS=
# Base Sepolia deployment values. Fill address/block from base-sepolia.escrow.json after deployment.
ESCROW_ADDRESS_TESTNET=
ESCROW_DEPLOYMENT_BLOCK_TESTNET=
PRE_ADDRESS_TESTNET=0x5471386EA2022e724A234A7690E338aA0A6689aD
USDC_ADDRESS_TESTNET=0xdeBe6c9F496Bb7cca66727E9B8CB5B49f631058D
INITIAL_OWNER_ADDRESS_TESTNET=
TREASURY_ADDRESS_TESTNET=
CHAIN_CONFIRMATIONS_TESTNET=6
# Existing Safe on the selected network. Keep the Transaction Service API key server-side.
SAFE_ADDRESS=
SAFE_ADDRESS_TESTNET=
SAFE_TRANSACTION_SERVICE_API_KEY=
# Optional only when using a custom Transaction Service deployment.
SAFE_TRANSACTION_SERVICE_URL=
SAFE_TRANSACTION_SERVICE_URL_TESTNET=
COMMUNITY_MIN_PRE=1
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_TIMEOUT_MS=5000
SIWE_DOMAIN=localhost:3011
SIWE_URI=http://localhost:3011
SESSION_SECRET=replace-with-at-least-32-random-characters
# Independent HMAC key used only for anonymous ad-report fingerprints.
ADS_REPORT_FINGERPRINT_SECRET=replace-with-an-independent-ads-report-secret
# Leave empty until the reviewed PRE Keyword Market contract handoff is complete.
ADS_CONTRACT_ADDRESS=
ADS_CONTRACT_DEPLOYMENT_BLOCK=
ADS_CONTRACT_ADDRESS_TESTNET=
ADS_CONTRACT_DEPLOYMENT_BLOCK_TESTNET=
