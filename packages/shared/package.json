{
  "name": "@precommunity/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "abi:sync": "node scripts/sync-escrow-abi.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server-config": {
      "types": "./dist/server-config.d.ts",
      "default": "./dist/server-config.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server-config": [
        "dist/server-config.d.ts"
      ]
    }
  },
  "dependencies": {
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  }
}
