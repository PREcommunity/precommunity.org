{
  "name": "@precommunity/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "backfill": "tsx src/backfill.ts",
    "check-chain-source": "tsx src/check-chain-source.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@precommunity/database": "workspace:*",
    "@precommunity/shared": "workspace:*",
    "@safe-global/api-kit": "^5.0.2",
    "bullmq": "^5.81.3",
    "ioredis": "^5.11.1",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "vitest": "^3.2.7"
  }
}
